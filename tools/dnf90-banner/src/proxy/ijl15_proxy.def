; =============================================================================
;  ijl15.dll 导出定义
;  -----------------------------------------------------------------------------
;  DNF.exe 是按序号导入的（实测使用 2 / 3 / 5），所以序号必须与原版逐一对齐，
;  只写函数名而不写 @序号 会导致序号错位，游戏调用到错误函数直接崩溃。
; =============================================================================
LIBRARY ijl15

EXPORTS
    ijlGetLibVersion @1
    ijlInit          @2
    ijlFree          @3
    ijlRead          @4
    ijlWrite         @5
    ijlErrorStr      @6
